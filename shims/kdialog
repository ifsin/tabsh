#!/bin/sh
REAL=$(which kdialog 2>/dev/null || echo "")
if [ -z "$REAL" ]; then
  echo "kdialog not found" >&2
  exit 1
fi
for arg in "$@"; do
  if [ "$arg" = "--passivepopup" ]; then
    TITLE="" BODY=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --title) TITLE="$2"; shift 2;;
        --passivepopup) BODY="$2"; shift 2;;
        *) shift;;
      esac
    done
    printf '\033]777;notify;%s;%s\007' "$TITLE" "$BODY" > /dev/tty 2>/dev/null
    exit 0
  fi
done
exec "$REAL" "$@"
